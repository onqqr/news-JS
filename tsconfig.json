{
    "compilerOptions": {
      "target": "ES2018",
      "module": "ESNext",
      "moduleResolution": "node",
      "strict": true,
      "noImplicitAny": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "outDir": "./dist",
      "baseUrl": "./"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
  }